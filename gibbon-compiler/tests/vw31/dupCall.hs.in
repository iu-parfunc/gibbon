-- Control for the evaluation-count check: the same program with the recursive
-- call written separately inside each alternative.  Two call sites, same
-- answer.
data T = A Int T | B Int T | End
{-# ANN type T "Linear" #-}
mkT :: Int -> T
mkT n = if n <= 0
        then End
        else if n < 3 then A n (mkT (n - 1)) else B (n + 200) (mkT (n - 1))
lenT :: T -> Int
lenT t = case t of { End -> 0 ; A x rst -> 1 + lenT rst ; B y rst -> 1 + lenT rst }
sumA :: T -> Int
sumA t = case t of { End -> 0 ; A x rst -> x + sumA rst ; B y rst -> sumA rst }
sumB :: T -> Int
sumB t = case t of { End -> 0 ; A x rst -> sumB rst ; B y rst -> y + sumB rst }
gibbon_main = let t = mkT @N@ in (lenT t, sumA t, sumB t)
