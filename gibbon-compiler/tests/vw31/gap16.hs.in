-- The alternatives DISAGREE on where the packed field starts -- A's tail is at
-- loc+25, B's at loc+9 -- so the value genuinely has to be re-placed.  The gap
-- is 16 bytes, more than the 9 an indirection needs, so the re-placement does
-- not overlap the value and is supported.  This is the control that shows the
-- refusal below is about the DISTANCE, not about differing layouts as such.
data T = A Int Int Int T | B Int T | End
{-# ANN type T "Linear" #-}
mkT :: Int -> T
mkT n = if n <= 0
        then End
        else let rst = mkT (n - 1)
              in if n < 3 then A n (n * 2) (n * 3) rst else B (n + 200) rst
lenT :: T -> Int
lenT t = case t of { End -> 0 ; A x y z rst -> 1 + lenT rst ; B w rst -> 1 + lenT rst }
sumA :: T -> Int
sumA t = case t of { End -> 0 ; A x y z rst -> x + y + z + sumA rst ; B w rst -> sumA rst }
sumB :: T -> Int
sumB t = case t of { End -> 0 ; A x y z rst -> sumB rst ; B w rst -> w + sumB rst }
gibbon_main = let t = mkT @N@ in (lenT t, sumA t, sumB t)
