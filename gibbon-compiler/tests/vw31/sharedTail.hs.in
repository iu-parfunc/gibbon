-- The canonical VW-31 reproducer: one recursive call, two constructor
-- alternatives consuming it.  The alternatives agree on the field layout, so
-- no re-placement is needed and this must simply work.
data T = A Int T | B Int T | End
{-# ANN type T "Linear" #-}
mkT :: Int -> T
mkT n = if n <= 0
        then End
        else let rst = mkT (n - 1)
              in if n < 3 then A n rst else B (n + 200) rst
lenT :: T -> Int
lenT t = case t of { End -> 0 ; A x rst -> 1 + lenT rst ; B y rst -> 1 + lenT rst }
sumA :: T -> Int
sumA t = case t of { End -> 0 ; A x rst -> x + sumA rst ; B y rst -> sumA rst }
sumB :: T -> Int
sumB t = case t of { End -> 0 ; A x rst -> sumB rst ; B y rst -> y + sumB rst }
gibbon_main = let t = mkT @N@ in (lenT t, sumA t, sumB t)
